# =============================================================================
# 训练命令汇总 (nohup 后台, 单行, 全绝对路径)
#
# 自动隔离 (脚本内已实现):
#   * METHOD_TAG = {simcot, simcot_sircl, codi, codi_sircl}
#   * EXPT_NAME 追加 "__${METHOD_TAG}",  SAVE_DIR 追加 "/${METHOD_TAG}"
#   * LOG_DIR = ${SAVE_DIR}/logs/${EXPT_NAME}-logs (TensorBoard)
#   -> 4 个变体 checkpoint / 日志互不覆盖
#
# 并发约束: MASTER_PORT 唯一 + CUDA_VISIBLE_DEVICES 不重叠 + nohup 日志名不同
# 本机 4 张卡, 不能让 gpt2 + qwen3 同时各占 4 张
#
# 全绝对路径: ssh 进任何容器后, 在任何 cwd 都能直接复制粘贴运行;
#             也可以直接 `gpux <alias> '<one-line>'` 转发到远端
# `< /dev/null` 关键: 让 nohup 真正脱离 ssh 的 stdin, 防止 ssh 不返回
# =============================================================================

mkdir -p /hpc2hdd/home/yhao481/jhupload/proj/baseline/CODI_rebuttal_runs/rebuttal_20260325/multimodel_gsm8k_math500_aime_v1/nohup_logs

